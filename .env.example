# AI Provider — set any combination (priority: OpenAI > OpenRouter > Anthropic)
# OpenAI = your personal key (no rate limits)
# OpenRouter/Anthropic = company keys (rate-limited to 10 calls/day)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Search APIs (priority: Bing > Serper > Exa)
# Bing = your personal key (no rate limits)
# Serper/Exa = company keys (rate-limited to 10 searches/day)
BING_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=

# App config
NEXT_PUBLIC_DEFAULT_FORMAT=champions-reg-m-a

# --- Auth (single-user passcode) ---
# Passcode you type at /login. CHANGE this to something only you know
# before deploying — anything plain works (a phrase, a UUID, etc.).
METAGROSS_PASSCODE=change-me

# Random ≥16-char secret used to sign session cookies. The value below
# was freshly generated for this checkout — replace it (or rotate it
# whenever you want to log everyone out) with:
#   openssl rand -hex 32
METAGROSS_AUTH_SECRET=d7babd7544ba5c773df3d78368117846fc8d793fc6ee2ec259fb59cf25948917
