# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# database
*.db
*.db-shm
*.db-wal
*.sqlite
/data/db/
/data/logs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Temporary Screenshots
/data/temp

# Codex
.codex

# Claude Code / plugin tooling
.claude/
.agents/
skills-lock.json

# Playwright
.playwright-mcp/*

# Scratch artifacts — keep the repo root clean (see CLAUDE.md).
# Screenshots, one-off probe scripts, and ad-hoc output must never be
# committed; write them to /tmp or .playwright-mcp/ instead.
/*.png
/*.jpg
/*.tmp.*
/probe.*
/dbcheck.*
